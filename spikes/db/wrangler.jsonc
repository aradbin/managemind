// Spike Workers for ADR 0002. Deleted after Phase 1 (plan Q7).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managemind-spike-db",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f2fced25d85f494ab0e9fd813a9a7534" }],
  "vars": {
    "PLACEMENT": "default",
    "PEER_URL": "https://managemind-spike-db-placed.aradworkspace.workers.dev"
  },
  "env": {
    // Same code, placed next to Neon (AWS ap-southeast-1, Singapore).
    "placed": {
      "name": "managemind-spike-db-placed",
      "placement": { "region": "aws:ap-southeast-1" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f2fced25d85f494ab0e9fd813a9a7534" }],
      "vars": {
        "PLACEMENT": "near-db",
        "PEER_URL": "https://managemind-spike-db.aradworkspace.workers.dev"
      }
    }
  }
}
