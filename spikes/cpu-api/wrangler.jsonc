// Spike Worker for ADRs 0003 and 0004. Deleted after Phase 1 (plan Q7).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "managemind-spike-cpu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
