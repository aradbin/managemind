---
import { type Locale, t } from '../i18n';

interface Props {
  title: string;
  locale: Locale;
}
const { title, locale } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; color: #1a1a1a; }
      header, footer, main { padding: 12px 16px; max-width: 960px; margin: 0 auto; }
      .price { font-size: 1.4rem; font-weight: 600; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
      dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; }
    </style>
  </head>
  <body>
    <header><a href="/">{t(locale, 'home')}</a></header>
    <main><slot /></main>
    <footer>© Demo Store · {t(locale, 'footer')}</footer>
  </body>
</html>
