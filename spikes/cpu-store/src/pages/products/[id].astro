---
// The "typical page": a server-rendered product page with about 20 product
// fields and 8 related products, data from the API over the service binding.
import { env } from 'cloudflare:workers';
import { type Locale, t } from '../../i18n';
import Base from '../../layouts/Base.astro';

if (Astro.url.searchParams.get('k') !== env.SPIKE_TOKEN) {
  return new Response('not found', { status: 404 });
}
const locale: Locale = Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'bn';
const trace = Astro.url.searchParams.get('trace') === '1';
const res = await env.API.fetch(
  `https://api.internal/v1/store/products/${Astro.params.id}${trace ? '?trace=1' : ''}`,
  { headers: { 'x-store': 'A', 'x-spike-key': env.SPIKE_TOKEN } },
);
if (res.status !== 200) return new Response('not found', { status: 404 });
const apiColo = res.headers.get('x-exec-colo');
type P = { id: string; title: string; price: number; description: string; createdAt: string };
const { product, related } = (await res.json()) as { product: P; related: P[] };

const money = new Intl.NumberFormat(locale === 'bn' ? 'bn-BD' : 'en-BD', {
  style: 'currency',
  currency: 'BDT',
});
const date = new Intl.DateTimeFormat(locale === 'bn' ? 'bn-BD' : 'en-BD', {
  dateStyle: 'medium',
  timeZone: 'Asia/Dhaka',
});
const price = (poisha: number) => money.format(poisha / 100);
const fields: [string, string][] = [
  ['SKU', product.id.slice(0, 8).toUpperCase()],
  ['Brand', 'Demo'],
  ['Category', 'Clothing'],
  ['Material', 'Cotton'],
  ['Colour', 'Navy'],
  ['Sizes', 'S, M, L, XL'],
  ['Fit', 'Regular'],
  ['Care', 'Machine wash'],
  ['Origin', 'Bangladesh'],
  ['Weight', '220 g'],
  ['Warranty', '7-day exchange'],
  ['Added', date.format(new Date(product.createdAt))],
  ['Price', price(product.price)],
  ['Compare at', price(Math.round(product.price * 1.2))],
  ['VAT', 'Included'],
  ['Stock', t(locale, 'inStock')],
  ['Delivery', t(locale, 'delivery')],
  ['Payment', t(locale, 'cod')],
  ['Rating', '4.6 / 5'],
  ['Reviews', '128'],
];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  sku: product.id,
  offers: { '@type': 'Offer', priceCurrency: 'BDT', price: product.price / 100 },
});
---

<Base title={product.title} locale={locale}>
  <script type="application/ld+json" set:html={jsonLd} />
  <h1>{product.title}</h1>
  <p class="price">{price(product.price)}</p>
  <button type="button">{t(locale, 'addToCart')}</button>
  <h2>{t(locale, 'details')}</h2>
  <p>{product.description}</p>
  <dl>
    {fields.map(([k, v]) => (
      <>
        <dt>{k}</dt>
        <dd>{v}</dd>
      </>
    ))}
  </dl>
  <h2>{t(locale, 'related')}</h2>
  <div class="grid">
    {related.map((r) => (
      <a href={`/products/${r.id}?lang=${locale}`}>
        <strong>{r.title}</strong>
        <span>{price(r.price)}</span>
      </a>
    ))}
  </div>
  {apiColo && <p data-api-colo={apiColo} />}
</Base>
