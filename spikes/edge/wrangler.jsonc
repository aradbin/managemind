// Spike Worker for ADR 0006 (edge state on the free plan). Deleted after Phase 1.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "managemind-spike-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  "queues": {
    "producers": [{ "binding": "Q", "queue": "managemind-spike-edge" }],
    "consumers": [
      {
        "queue": "managemind-spike-edge",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "dead_letter_queue": "managemind-spike-edge-dlq"
      },
      { "queue": "managemind-spike-edge-dlq", "max_batch_size": 10, "max_batch_timeout": 1 }
    ]
  },
  // The cron ("17 * * * *") was verified on 2026-10-09 and then removed, to
  // keep the account's five cron triggers free.
  "triggers": { "crons": [] }
}
