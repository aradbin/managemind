{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["SENTRY_SOURCEMAPS", "VITE_SENTRY_*"]
    },
    "typecheck": {},
    "test": {
      "env": ["TEST_DATABASE_URL"]
    }
  }
}
