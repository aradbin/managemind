// The API Worker. Values here are for local development; preview and
// production settings are added with the deploy workflows (PRs 17 and 18).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "managemind-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Next to Neon in Singapore (ADR 0002).
  "placement": { "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true },
  // Real Hyperdrive config IDs per environment are created by provisioning
  // (PR 18). Locally, wrangler dev connects to the session's Postgres as
  // mm_app_dev, a login role in app_rw, so RLS is on exactly as in
  // production (`pnpm --filter @managemind/db db:dev-setup` creates it).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://mm_app_dev:mm_app_dev@127.0.0.1:5432/managemind"
    }
  ],
  "queues": {
    "producers": [{ "binding": "OUTBOX", "queue": "managemind-outbox" }],
    "consumers": [
      {
        "queue": "managemind-outbox",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "managemind-outbox-dlq"
      }
    ]
  },
  // The daily batch (ADR 0010): 23:47 UTC is 05:47 in Dhaka, before the day's
  // traffic, and off the hour to avoid Cron congestion.
  "triggers": { "crons": ["47 23 * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "PLATFORM_NAME": "managemind",
    "PLATFORM_DOMAIN": "localhost",
    "STORE_DOMAIN": "localhost",
    "LOG_SAMPLE_RATE": "1"
  }
}
