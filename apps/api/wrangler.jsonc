// The API Worker. Values here are for local development; preview and
// production settings are added with the deploy workflows (PRs 17 and 18).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "managemind-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Next to Neon in Singapore (ADR 0002).
  "placement": { "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true },
  // The admin SPA (apps/admin, built into its dist) at the root of the host
  // (phase-1-plan §3.5). Files and client-side routes are served without
  // invoking the Worker; unknown paths get index.html. Only the API paths
  // reach the Worker first.
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/health", "/health/*", "/openapi.json"]
  },
  // Real Hyperdrive config IDs per environment are created by provisioning
  // (PR 18). Locally, wrangler dev connects to the session's Postgres as
  // mm_app_dev, a login role in app_rw, so RLS is on exactly as in
  // production (`pnpm --filter @managemind/db db:dev-setup` creates it).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://mm_app_dev:mm_app_dev@127.0.0.1:5432/managemind"
    }
  ],
  // The host-to-store map (ADR 0015), written by the outbox consumer. The
  // production namespace ID is set by provisioning; previews get no binding.
  "kv_namespaces": [{ "binding": "EDGE", "id": "00000000000000000000000000000000" }],
  // Store files: product images under tenants/<id>/media/ (ADR 0016). The
  // deployed bucket is set per environment by scripts/lib/workers.ts.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "managemind-files-preview" }],
  // Rate limits (ADR 0006): SQLite-backed, the only kind on the Free plan.
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "queues": {
    "producers": [
      { "binding": "OUTBOX", "queue": "managemind-outbox" },
      { "binding": "IMPORTS", "queue": "managemind-imports" }
    ],
    "consumers": [
      {
        "queue": "managemind-outbox",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "managemind-outbox-dlq"
      },
      // Import chunks (phase-2-plan §3.7): one chunk per invocation, so one
      // invocation never holds two chunks' CPU. A chunk that keeps failing goes
      // to the dead-letter queue, whose consumer marks the job failed.
      {
        "queue": "managemind-imports",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "managemind-imports-dlq"
      },
      { "queue": "managemind-imports-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  // The daily batch (ADR 0010): 23:47 UTC is 05:47 in Dhaka, before the day's
  // traffic, and off the hour to avoid Cron congestion.
  "triggers": { "crons": ["47 23 * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "PLATFORM_NAME": "managemind",
    "PLATFORM_DOMAIN": "localhost",
    "STORE_DOMAIN": "localhost",
    "LOG_SAMPLE_RATE": "1"
  }
}
