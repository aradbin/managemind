// The storefront Worker. Values here are for local development; preview and
// production settings come with the deploy workflows (PRs 17 and 18).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "managemind-storefront",
  // Astro's handler, wrapped with Sentry.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-15",
  // Sentry needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // Not placed: shopper pages are served from the location nearest the
  // shopper; the API it calls is placed next to Neon (ADRs 0002, 0003).
  "services": [{ "binding": "API", "service": "managemind-api" }],
  // Images for /media/* (ADR 0016); the deployed bucket is set per
  // environment by scripts/lib/workers.ts.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "managemind-files-preview" }],
  "vars": {
    "ENVIRONMENT": "development",
    "STORE_DOMAIN": "localhost",
    "PLATFORM_DOMAIN": "localhost",
    "ADMIN_HOST": "localhost:8787"
  }
}
