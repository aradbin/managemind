---
// Phase 0 placeholder: proves tenant resolution from the hostname (or the dev
// selector) through the API. The real storefront arrives in Phase 3.
import { t } from '@managemind/shared/i18n';
import Base from '../layouts/Base.astro';

const { store, locale, host } = Astro.locals;
if (!store) Astro.response.status = 404;
---

{
  store ? (
    <Base title={store.name}>
      <h1>{t(locale, 'store.placeholder.welcome', { store: store.name })}</h1>
    </Base>
  ) : (
    <Base title={t(locale, 'store.notFound.title')}>
      <h1>{t('bn', 'store.notFound.title')}</h1>
      <p>{t('bn', 'store.notFound.body', { host })}</p>
      <h2 lang="en">{t('en', 'store.notFound.title')}</h2>
      <p lang="en">{t('en', 'store.notFound.body', { host })}</p>
    </Base>
  )
}
