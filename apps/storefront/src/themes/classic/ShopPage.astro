---
// A shopper page's frame (phase-4-plan §3.16): a cached shell with no
// personal data, noindex, whose script fills it from /api/*. It carries the
// messages and links its script needs, in the page's language.
import type { ShopFacts } from '@managemind/core';
import { formatPhone } from '@managemind/shared';
import { geoFilePath } from '@managemind/shared/geo/version';
import { type ShellKind, storePath } from '@managemind/shared/storefront/urls';
import { bn, en, type StoreMessageKey } from '../../i18n';
import { href } from '../../lib/links';
import type { PageContext } from '../../lib/page';
import Layout from './Layout.astro';
import type { Tab } from './TabBar.astro';

interface Props {
  ctx: PageContext;
  kind: ShellKind;
  title: string;
  /** The messages the page's script uses. */
  keys: StoreMessageKey[];
  /** The cart and checkout: what the store promises (delivery, COD, returns). */
  facts?: ShopFacts | null;
  /** Checkout: the store name, "Secure checkout" and Back to cart, with no site navigation. */
  chrome?: 'full' | 'minimal';
}
const { ctx, kind, title, keys, facts = null, chrome = 'full' } = Astro.props;
// Cart and checkout pages have their own pinned bars, so no bottom bar.
const tab: Tab | false =
  kind === 'cart' || kind === 'checkout' || kind === 'metaCheckout'
    ? false
    : kind === 'account'
      ? 'account'
      : null;
const { t, locale, defaultLocale } = ctx;
const other = locale === 'bn' ? 'en' : 'bn';
const terms = ctx.layout.pages.find((p) => p.kind === 'terms');
const shop = {
  locale,
  numerals: ctx.d.numerals,
  prefix: locale === defaultLocale ? '' : `/${locale}`,
  // Plural messages go as both forms: the script picks one by the count.
  msg: Object.fromEntries(
    keys.map((k) => {
      const raw = (locale === 'bn' ? bn : en)[k];
      return [k, typeof raw === 'string' ? t(k) : { one: raw.one, other: raw.other }];
    }),
  ),
  links: {
    home: href(ctx.link, { kind: 'home' }),
    cart: href(ctx.link, { kind: 'cart' }),
    checkout: href(ctx.link, { kind: 'checkout' }),
    thanks: href(ctx.link, { kind: 'thanks' }),
    track: href(ctx.link, { kind: 'track' }),
    account: href(ctx.link, { kind: 'account' }),
    terms: terms ? href(ctx.link, { kind: 'page', slug: terms.slug }) : null,
  },
  shop: ctx.layout.shop,
  // The store's WhatsApp, for the cart's "Order on WhatsApp" (phase-9-plan §3.1.3).
  whatsapp:
    ctx.layout.storefront.chat.show !== 'none'
      ? (ctx.layout.storefront.chat.whatsapp ?? null)
      : null,
  geo: geoFilePath(),
  phone: ctx.layout.store.profile.contactPhone
    ? formatPhone(ctx.layout.store.profile.contactPhone, ctx.d.numerals)
    : null,
  // Delivery zones in the page's language, cash on delivery, online payment and returns.
  facts: facts
    ? {
        zones: facts.zones.map((z) => ({
          name: z.name[locale],
          fee: z.fee,
          estimate: z.estimate?.[locale] ?? null,
        })),
        cod: facts.cod,
        online: facts.online,
        returnDays: facts.returns.shopperRequests ? facts.returns.windowDays : null,
      }
    : null,
};
---

<Layout ctx={ctx} head={{ title: `${title} | ${ctx.layout.store.name}`, canonical: null, alternates: [], noindex: true }} languageHref={storePath({ kind }, other, defaultLocale)} tab={tab} chrome={chrome}>
  <slot />
  <script type="application/json" id="mm-shop" set:html={JSON.stringify(shop).replace(/</g, '\\u003c')} />
</Layout>
