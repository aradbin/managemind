---
// The classic theme's frame for every page (phase-3-plan §3.4–§3.10): head
// tags and structured data, the store's tokens as CSS variables, the
// announcement or holiday bar, header, footer, chat buttons, and the consent
// banner with the tag loader. Pages never vary by cookie: consent is read by
// the script in the browser, so one cached copy serves every shopper.
import { t as shared } from '@managemind/shared/i18n';
import { DEFAULT_CONSENT_TEXT, messengerLink, whatsappLink } from '@managemind/shared/storefront';
import type { PageContext } from '../../lib/page';
import { previewParents } from '../../lib/preview';
import { type Head, ldJson } from '../../lib/seo';
import Footer from './Footer.astro';
import Header from './Header.astro';
import './theme.css';

interface Props {
  ctx: PageContext;
  head: Head;
  /** This page in the other language, for the switch. */
  languageHref: string;
  /** Product pages: chat greetings name the product, and tags get a product view. */
  product?: { id: string; title: string; price: number; url: string } | null;
}
const { ctx, head, languageHref, product = null } = Astro.props;
const { theme, layout, t, locale } = ctx;
const c = theme.tokens.colors;
const radius = { none: '0', small: '6px', large: '14px' }[theme.tokens.radius];
const system =
  "system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans Bengali', 'Noto Sans', sans-serif";
const hind = theme.tokens.font === 'hind-siliguri';
const font = hind ? `'Hind Siliguri', ${system}` : system;
const ratio = theme.tokens.card.imageRatio === '3:4' ? '3 / 4' : '1 / 1';
// Colours are validated #rrggbb (shared themeSchema), so this is safe to inline.
const vars = `:root{--c-primary:${c.primary};--c-on-primary:${c.onPrimary};--c-background:${c.background};--c-surface:${c.surface};--c-text:${c.text};--c-accent:${c.accent};--c-sale:${c.sale};--radius:${radius};--font:${font};--card-ratio:${ratio}}`;
const face = (subset: string, weight: number, range: string) =>
  `@font-face{font-family:'Hind Siliguri';font-style:normal;font-display:swap;font-weight:${weight};src:url(/fonts/hind-siliguri-${subset}-${weight}-normal.woff2) format('woff2');unicode-range:${range}}`;
const BENGALI = 'U+0951-0952,U+0964-0965,U+0980-09FE,U+1CD0-1CF9,U+200C-200D,U+20B9,U+25CC,U+A8F1';
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2212';
const fonts = hind
  ? [400, 600].flatMap((w) => [face('bengali', w, BENGALI), face('latin', w, LATIN)]).join('')
  : '';

const favicon = ctx.image(theme.tokens.faviconMediaId);
const storefront = layout.storefront;
const announcement = theme.announcement;
const announcementText = announcement ? ctx.text(announcement.text) : '';
const announcementHref = announcement ? ctx.themeLink(announcement.link) : null;
const holiday = storefront.holiday;
const holidayText = holiday ? ctx.text(holiday.message) : '';

const chat = storefront.chat;
const showChat =
  (chat.show === 'all' || (chat.show === 'product' && product !== null)) &&
  Boolean(chat.whatsapp || chat.messenger);
const greeting = ctx.text(chat.greeting);
const chatText = product
  ? t('chat.productGreeting', { greeting, product: product.title, url: product.url }).trim()
  : greeting;

const tracking = storefront.tracking;
const hasTags = Boolean(tracking.metaPixelId || tracking.ga4Id);
const consentText = ctx.text(storefront.consent.text) || DEFAULT_CONSENT_TEXT[locale];
// The theme editor sends colours, fonts and corners while the owner edits; only
// the admin's origin is listened to, and only the theme's own variables are set.
const parents = ctx.preview ? JSON.stringify(previewParents()) : '[]';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{head.title}</title>
    {head.description && <meta name="description" content={head.description} />}
    {head.noindex && <meta name="robots" content="noindex, follow" />}
    {head.canonical && <link rel="canonical" href={head.canonical} />}
    {head.alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.url} />)}
    <meta property="og:site_name" content={layout.store.name} />
    <meta property="og:title" content={head.title} />
    <meta property="og:type" content={head.type ?? 'website'} />
    {head.canonical && <meta property="og:url" content={head.canonical} />}
    {head.description && <meta property="og:description" content={head.description} />}
    {head.image && <meta property="og:image" content={head.image} />}
    <meta property="og:locale" content={locale === 'bn' ? 'bn_BD' : 'en_US'} />
    <meta name="twitter:card" content={head.image ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content={c.primary} />
    {favicon?.files[0] && <link rel="icon" href={`/media/${favicon.files[0].file}`} />}
    {hind && <link rel="preload" href={`/fonts/hind-siliguri-${locale === 'bn' ? 'bengali' : 'latin'}-400-normal.woff2`} as="font" type="font/woff2" crossorigin />}
    <style set:html={fonts + vars}></style>
    {(head.jsonLd ?? []).map((data) => <script type="application/ld+json" set:html={ldJson(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t('skip.content')}</a>
    {Astro.locals.devStore && (
      <p class="bar preview-bar" role="note">{shared(locale, 'store.devBanner', { store: layout.store.name })}</p>
    )}
    {ctx.preview && <p class="bar preview-bar" role="note">{t('preview.banner')}</p>}
    {ctx.preview && (
      <script is:inline define:vars={{ parents }}>
        (function(){var ok=JSON.parse(parents);var keys=['--c-primary','--c-on-primary','--c-background','--c-surface','--c-text','--c-accent','--c-sale','--radius','--font','--card-ratio'];addEventListener('message',function(e){if(ok.indexOf(e.origin)<0||!e.data||e.data.type!=='mm-theme-vars')return;var v=e.data.vars||{};keys.forEach(function(k){var x=v[k];if(typeof x==='string'&&x.length<200&&!/[;{}<>]/.test(x))document.documentElement.style.setProperty(k,x);});});})();
      </script>
    )}
    {holiday && holidayText && (
      <p class="bar" id="mm-holiday" role="note" hidden data-start={holiday.startsAt} data-end={holiday.endsAt}>{holidayText}</p>
    )}
    {announcementText && (
      <p class="bar" id="mm-announcement">
        {announcementHref ? <a href={announcementHref}>{announcementText}</a> : announcementText}
      </p>
    )}
    {holiday && (
      <script is:inline>
        (function(){var h=document.getElementById('mm-holiday');if(!h)return;var n=Date.now();if(n>=Date.parse(h.dataset.start)&&n<Date.parse(h.dataset.end)){h.hidden=false;var a=document.getElementById('mm-announcement');if(a)a.hidden=true;}})();
      </script>
    )}
    <Header ctx={ctx} languageHref={languageHref} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer ctx={ctx} consent={hasTags} />
    {showChat && (
      <div class="chat">
        {chat.whatsapp && (
          <a class="wa" href={whatsappLink(chat.whatsapp, chatText || undefined)} target="_blank" rel="noopener" aria-label={t('chat.whatsapp')}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
          </a>
        )}
        {chat.messenger && (
          <a class="ms" href={messengerLink(chat.messenger, chatText || undefined)} target="_blank" rel="noopener" aria-label={t('chat.messenger')}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.4 2 2 6.1 2 11.6a9.4 9.4 0 0 0 3.1 7.1v3.3l3-1.7a10.8 10.8 0 0 0 3.9.7c5.6 0 10-4.1 10-9.5S17.6 2 12 2Zm1 12.8-2.5-2.7-5 2.7L11 9l2.6 2.7 4.9-2.7Z"/></svg>
          </a>
        )}
      </div>
    )}
    {hasTags && (
      <>
        <section class="consent" id="mm-consent" hidden aria-label={t('consent.label')}>
          <p>{consentText}</p>
          <div class="actions">
            <button type="button" class="button" data-consent="granted">{t('consent.accept')}</button>
            <button type="button" class="button secondary" data-consent="denied">{t('consent.reject')}</button>
          </div>
        </section>
        <div
          id="mm-tracking"
          hidden
          data-pixel={tracking.metaPixelId}
          data-ga4={tracking.ga4Id}
          data-pixel-purchase={ctx.layout.pixelPurchase ? undefined : 'off'}
          data-product={product ? JSON.stringify({ id: product.id, name: product.title, price: product.price }) : undefined}
        ></div>
        <script src="./scripts/consent.ts"></script>
      </>
    )}
  </body>
</html>
