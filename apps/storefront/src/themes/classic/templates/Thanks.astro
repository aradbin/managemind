---
import type { StoreMessageKey } from '../../../i18n';
import type { PageContext } from '../../../lib/page';
import ShopPage from '../ShopPage.astro';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const { t } = ctx;
const keys: StoreMessageKey[] = [
  'thanks.title',
  'thanks.number',
  'thanks.cod',
  'thanks.next',
  'thanks.missing',
  'thanks.items',
  'thanks.deliverTo',
  'track.title',
  'pay.paid',
  'pay.failed',
  'pay.cancelled',
  'pay.due',
  'pay.now',
  'cart.subtotal',
  'cart.discount',
  'cart.delivery',
  'cart.free',
  'cart.vatIncluded',
  'cart.vat',
  'cart.rounding',
  'cart.total',
  'cart.error',
  'track.status',
  'status.pending',
  'status.confirmed',
  'status.processing',
  'status.completed',
  'status.cancelled',
  'track.delivery',
  'delivery.not_shipped',
  'delivery.partially_shipped',
  'delivery.shipped',
  'delivery.delivered',
  'delivery.failed',
  'track.shipments',
  'track.courier',
  'shipment.shipped',
  'shipment.delivered',
  'shipment.failed',
  'shipment.returned',
  'shipment.booked',
  'shipment.in_transit',
  'track.updates',
  'courier.booked',
  'courier.picked_up',
  'courier.in_transit',
  'courier.on_hold',
  'courier.delivered',
  'courier.partial_delivered',
  'courier.returning',
  'courier.returned',
  'courier.cancelled',
  'track.cancel',
  'track.cancelConfirm',
  'track.cancelled',
];
---

<ShopPage ctx={ctx} kind="thanks" title={t('thanks.title')} keys={keys}>
  <div class="shop narrow" data-thanks aria-live="polite">
    <h1>{t('thanks.title')}</h1>
    <noscript><p>{t('thanks.next')}</p></noscript>
  </div>
  <script src="../scripts/order.ts"></script>
</ShopPage>
