---
import type { ShopFacts } from '@managemind/core';
import type { StoreMessageKey } from '../../../i18n';
import type { PageContext } from '../../../lib/page';
import ShopPage from '../ShopPage.astro';

interface Props {
  ctx: PageContext;
  facts?: ShopFacts | null;
}
const { ctx, facts = null } = Astro.props;
const { t } = ctx;
const keys: StoreMessageKey[] = [
  'cart.empty',
  'cart.continue',
  'cart.error',
  'cart.quantity',
  'cart.decrease',
  'cart.increase',
  'cart.remove',
  'cart.unavailable',
  'cart.insufficient',
  'cart.overLimit',
  'cart.code',
  'cart.apply',
  'cart.removeCode',
  'cart.codeApplied',
  'cart.code.not_found',
  'cart.code.inactive',
  'cart.code.used_up',
  'cart.code.min_subtotal',
  'cart.code.better_offer',
  'cart.code.other',
  'cart.subtotal',
  'cart.discount',
  'cart.delivery',
  'cart.deliveryFrom',
  'cart.free',
  'cart.vatIncluded',
  'cart.vat',
  'cart.rounding',
  'cart.total',
  'cart.freeDelivery',
  'cart.checkout',
  'cart.orderWhatsapp',
  'cart.orderWhatsappIntro',
  'cart.fix',
  'product.regular',
  'cart.items',
  'cart.subtotalCount',
  'cart.summary',
  'cart.atCheckout',
  'cart.promo',
  'cart.each',
  'cart.removeShort',
  'cart.emptyText',
  'cart.start',
  'cart.deliveryNote',
  'cart.checkoutShort',
  'trust.cod',
  'trust.returns',
  'trust.online',
];
---

<ShopPage ctx={ctx} facts={facts} kind="cart" title={t('cart.title')} keys={keys}>
  <div class="listing-head">
    <h1>{t('cart.title')}</h1>
    <p class="count" data-cart-items></p>
  </div>
  <div class="shop" data-cart aria-live="polite">
    <p class="muted" data-loading>{t('cart.loading')}</p>
    <noscript><p>{t('cart.noscript')}</p></noscript>
  </div>
  <script src="../scripts/cart.ts"></script>
</ShopPage>
