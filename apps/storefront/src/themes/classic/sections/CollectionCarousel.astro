---
import type { StoreCollection, StoreImage } from '@managemind/core';
import type { ThemeSection } from '@managemind/shared/storefront';
import { href } from '../../../lib/links';
import type { PageContext } from '../../../lib/page';
import Img from '../Img.astro';

interface Props {
  ctx: PageContext;
  section: Extract<ThemeSection, { type: 'collection_carousel' }>;
  collections: (StoreCollection & { image: StoreImage | null })[];
}
const { ctx, section, collections } = Astro.props;
const heading = ctx.text(section.heading);
---

{collections.length > 0 && (
  <section class="section" aria-labelledby={`s-${section.id}`}>
    <h2 id={`s-${section.id}`}>{heading}</h2>
    <ul class="carousel" role="list">
      {collections.map((c) => (
        <li>
          <a class="tile" href={href(ctx.link, { kind: 'collection', slug: c.slug })}>
            <div class="tile-media" style="aspect-ratio: var(--card-ratio)">{c.image && <Img image={c.image} alt="" sizes="(min-width: 900px) 23vw, 44vw" />}</div>
            <span>{c.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
