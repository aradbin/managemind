---
// A grid of products on a full-width pale band, with "View all" when it shows
// a collection (design/storefront-redesign: Today's deals, New arrivals).
import type { ProductCard } from '@managemind/core';
import type { ThemeSection } from '@managemind/shared/storefront';
import type { PageContext } from '../../../lib/page';
import ProductList from '../ProductList.astro';

interface Props {
  ctx: PageContext;
  section: Extract<ThemeSection, { type: 'product_grid' }>;
  products: ProductCard[];
  eager: boolean;
}
const { ctx, section, products, eager } = Astro.props;
const heading = ctx.text(section.heading);
const all = section.collectionId
  ? ctx.themeLink({ type: 'collection', id: section.collectionId })
  : null;
---

{products.length > 0 && (
  <section class="section band" aria-labelledby={`s-${section.id}`}>
    <div class="section-head">
      <h2 id={`s-${section.id}`}>{heading}</h2>
      {all && <a href={all}>{ctx.t('section.viewAll')}<span class="visually-hidden">: {heading}</span></a>}
    </div>
    <ProductList ctx={ctx} products={products} layout={section.layout} eagerFirst={eager} />
  </section>
)}
