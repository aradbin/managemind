---
// The site footer of the redesign (design/storefront-redesign: SiteFooter and
// PhoneFooter): the store name and contact, Shop (the top-level categories),
// Help (tracking, the account and the store's own pages), the business details
// the guidelines ask for, then the legal pages, cookie settings and the
// language link along the bottom.
import { formatPhone } from '@managemind/shared';
import type { PageKind } from '@managemind/shared/storefront';
import { number } from '../../lib/format';
import { href } from '../../lib/links';
import type { PageContext } from '../../lib/page';

interface Props {
  ctx: PageContext;
  /** Shows "Cookie settings" when the store has tracking tags. */
  consent: boolean;
  /** This page in the other language. */
  languageHref: string;
}
const { ctx, consent, languageHref } = Astro.props;
const { layout, t, d, locale } = ctx;
const other = locale === 'bn' ? 'en' : 'bn';
const profile = layout.store.profile;
const business = [
  ['footer.businessName', profile.businessName],
  ['footer.tradeLicense', profile.tradeLicense],
  ['footer.dbid', profile.dbid],
  ['footer.bin', profile.bin],
].filter((e): e is [Parameters<typeof t>[0], string] => Boolean(e[1]));
const address = profile.address
  ? [profile.address.line1, profile.address.line2, profile.address.city].filter(Boolean).join(', ')
  : null;
const year = number(new Date().getUTCFullYear(), d).replace(/[,،]/g, '');
const LEGAL: readonly PageKind[] = ['terms', 'privacy'];
const legal = layout.pages.filter((p) => LEGAL.includes(p.kind));
const help = layout.pages.filter((p) => !LEGAL.includes(p.kind));
const roots = layout.categories.filter((c) => c.parentId === null).slice(0, 8);
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <section class="footer-store" aria-labelledby="footer-contact">
      <h2 id="footer-contact" class="footer-name">{layout.store.name}</h2>
      <ul role="list">
        {profile.contactPhone && <li><a href={`tel:${profile.contactPhone}`}>{formatPhone(profile.contactPhone, d.numerals)}</a></li>}
        {profile.contactEmail && <li><a href={`mailto:${profile.contactEmail}`}>{profile.contactEmail}</a></li>}
        {address && <li>{address}</li>}
      </ul>
    </section>
    {roots.length > 0 && (
      <nav id="footer-shop" aria-labelledby="footer-shop-title">
        <h2 id="footer-shop-title">{t('footer.shop')}</h2>
        <ul role="list">
          {roots.map((c) => <li><a href={href(ctx.link, { kind: 'category', slug: c.slug })}>{c.name}</a></li>)}
        </ul>
      </nav>
    )}
    <nav aria-labelledby="footer-help">
      <h2 id="footer-help">{t('footer.help')}</h2>
      <ul role="list">
        <li><a href={href(ctx.link, { kind: 'track' })}>{t('track.title')}</a></li>
        {layout.shop.accounts && <li><a href={href(ctx.link, { kind: 'account' })}>{t('nav.account')}</a></li>}
        {help.map((p) => <li><a href={href(ctx.link, { kind: 'page', slug: p.slug })}>{p.title}</a></li>)}
      </ul>
    </nav>
    {business.length > 0 && (
      <section aria-labelledby="footer-business">
        <h2 id="footer-business">{t('footer.business')}</h2>
        <dl>
          {business.map(([key, value]) => (<div><dt>{t(key)}</dt><dd>{value}</dd></div>))}
        </dl>
      </section>
    )}
  </div>
  <div class="wrap footer-bottom">
    <p>{t('footer.rights', { year, store: layout.store.name })}</p>
    <ul role="list">
      {legal.map((p) => <li><a href={href(ctx.link, { kind: 'page', slug: p.slug })}>{p.title}</a></li>)}
      {consent && <li><button type="button" class="linkish" data-consent-open>{t('footer.cookies')}</button></li>}
      <li><a href={languageHref} hreflang={other} lang={other}>{other === 'bn' ? 'বাংলা' : 'English'}</a></li>
    </ul>
  </div>
</footer>
