---
// The product card of the redesign (design/storefront-redesign: ProductCard):
// photo with the discount or sold-out badge, a two-line title, the options
// line ("4 sizes · 3 colours", kept empty on products without options so a
// row's prices and buttons line up), the price, then the action:
// - one variant: Add to cart, which adds it here (scripts/card.ts);
// - several: Choose options, a link to the product page;
// - sold out: none.
// Desktop shows the action as a full-width button; phones as a round cart
// button on the photo's corner. It is one element either way.
import type { CardOption, ProductCard } from '@managemind/core';
import { price, priceRange } from '../../lib/format';
import { href } from '../../lib/links';
import type { PageContext } from '../../lib/page';
import { swatch } from '../../lib/swatches';
import Icon from './Icon.astro';
import Img from './Img.astro';

interface Props {
  ctx: PageContext;
  product: ProductCard;
  eager?: boolean;
}
const { ctx, product, eager = false } = Astro.props;
const { t, d, theme } = ctx;
const card = theme.tokens.card;
const link = href(ctx.link, { kind: 'product', slug: product.slug });
const onSale =
  card.showCompareAt &&
  product.compareAt !== null &&
  product.priceMin !== null &&
  product.compareAt > product.priceMin;
const percent =
  onSale && product.compareAt && product.priceMin !== null
    ? Math.round(((product.compareAt - product.priceMin) / product.compareAt) * 100)
    : 0;
const ranged =
  product.priceMax !== null && product.priceMin !== null && product.priceMax !== product.priceMin;

const SIZE = new Set(['size', 'সাইজ', 'মাপ']);
const COLOUR = new Set(['colour', 'color', 'রং', 'রঙ']);
const is = (o: CardOption, names: Set<string>) => o.keys.some((k) => names.has(k));
const many = (product.options ?? []).filter((o) => o.values.length > 1);
const colour = many.find((o) => is(o, COLOUR));
const dots = (colour?.values ?? [])
  .map(swatch)
  .filter((c): c is string => c !== null)
  .slice(0, 4);
const parts = many.map((o) =>
  t(is(o, SIZE) ? 'card.sizes' : is(o, COLOUR) ? 'card.colours' : 'card.options', {
    count: o.values.length,
  }),
);
const action = !product.available ? null : product.variantId ? 'add' : 'choose';
---

<article class="card">
  <div class="card-media">
    {product.image && (
      <Img image={product.image} alt="" sizes="(min-width: 1000px) 25vw, (min-width: 640px) 33vw, 50vw" eager={eager} />
    )}
    {!product.available ? (
      <span class="badge out">{t('product.outOfStock')}</span>
    ) : (
      percent > 0 && <span class="badge">{t('card.off', { percent })}</span>
    )}
  </div>
  <div class="card-text">
    {card.showBrand && product.brand && <p class="card-brand">{product.brand}</p>}
    <h3 class="card-title"><a href={link}>{product.title}</a></h3>
  </div>
  <p class="card-options" aria-hidden={parts.length ? undefined : 'true'}>
    {dots.map((c) => <span class="dot" style={`background:${c}`} />)}
    {parts.join(' · ')}
  </p>
  {product.priceMin !== null && (
    <p class="price">
      <span class={onSale ? 'sale' : undefined}>
        {ranged ? t('product.from', { price: price(product.priceMin, d) }) : priceRange(product.priceMin, product.priceMax, d)}
      </span>
      {onSale && product.compareAt !== null && (
        <s class="compare"><span class="visually-hidden">{t('product.regular')}: </span>{price(product.compareAt, d)}</s>
      )}
    </p>
  )}
  {action === 'add' && (
    <div class="card-action" data-card-add={product.variantId} data-name={product.title} data-price={product.priceMin ?? 0} data-adding={t('cart.adding')} data-error={t('cart.error')}>
      <button type="button" class="card-button" aria-label={t('card.addAria', { product: product.title })}>
        <Icon name="cart" size={18} stroke={2} /><span class="card-label">{t('cart.add')}</span>
      </button>
      <a class="card-button card-added" href={href(ctx.link, { kind: 'cart' })} role="status" hidden>
        <Icon name="check" size={16} stroke={2.25} /><span class="card-label">{t('card.added')}</span>
      </a>
    </div>
  )}
  {action === null && <div class="card-action none" />}
  {action === 'choose' && (
    <div class="card-action">
      <a class="card-button" href={link} aria-label={t('card.chooseAria', { product: product.title })}>
        <Icon name="cart" size={18} stroke={2} /><span class="card-label">{t('card.choose')}</span>
      </a>
    </div>
  )}
</article>
<script src="./scripts/card.ts"></script>
